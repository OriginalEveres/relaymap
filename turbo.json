{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "concurrency": "15",
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "API_PORT", "API_CORS_ORIGINS", "CRAWL_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**"]
    },
    "db:generate": {
      "cache": false,
      "outputs": ["src/generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build", "db:generate"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
