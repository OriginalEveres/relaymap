# Postgres
DATABASE_URL="postgresql://relaymap:relaymap@localhost:5432/relaymap?schema=public"

# API
API_PORT=3000
API_CORS_ORIGINS="http://localhost:3001"

# Crawler
CRAWL_CRON="0 */6 * * *"
CRAWL_MAX_CONCURRENT=500
CRAWL_MAX_DEPTH=2
CRAWL_CONNECT_TIMEOUT_MS=5000
CRAWL_HANDSHAKE_TIMEOUT_MS=5000

# MaxMind GeoLite2 (paths mounted in container)
MAXMIND_CITY_DB_PATH=/data/geoip/GeoLite2-City.mmdb
MAXMIND_ASN_DB_PATH=/data/geoip/GeoLite2-ASN.mmdb
MAXMIND_GEO_REFRESH_DAYS=30
